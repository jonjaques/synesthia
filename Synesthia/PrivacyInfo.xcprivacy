<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Synesthia is entirely local: audio is analysed in-process and never
	  stored or transmitted, there are no third-party SDKs, no networking, and
	  no analytics. Everything below is therefore empty by design — keep it
	  that way, or update this file (and the App Store Connect privacy
	  answers, which must match) in the same commit.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: access info from UserDefaults written only by this app. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
