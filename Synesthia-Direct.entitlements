<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Direct-download (Developer ID / notarized) and Debug entitlements.
	     Identical to the App Store set plus the two Apple Events entitlements
	     the Music.app source needs. The temporary exception is required because
	     Music.app publishes no scripting-targets group; outside the Mac App
	     Store it carries no review risk. Builds using this file must also
	     define MUSIC_APP_SOURCE. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.temporary-exception.apple-events</key>
	<array>
		<string>com.apple.Music</string>
	</array>
</dict>
</plist>
