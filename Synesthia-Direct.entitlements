<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Direct-download (Developer ID / notarized) and Debug entitlements.
	     Identical to the App Store set plus the two Apple Events entitlements
	     the optional player-control layer needs.

	     Note what these are *not* for: knowing what is playing needs no
	     permission at all, because players broadcast it as a distributed
	     notification (see NowPlayingObserver). These buy the two things a
	     broadcast cannot carry — transport control and real cover art — and
	     the app sends its first Apple Event only when the user picks
	     "Control Music…" / "Control Spotify…" from a menu.

	     The temporary exception is required because neither Music nor Spotify
	     publishes a scripting-targets group; outside the Mac App Store it
	     carries no review risk. Builds using this file must also define
	     MUSIC_APP_SOURCE. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.temporary-exception.apple-events</key>
	<array>
		<string>com.apple.Music</string>
		<string>com.spotify.client</string>
	</array>
	<!-- Sparkle. Only the `Synesthia Direct` target links it; the App Store
	     target has no updater and none of these three entitlements.

	     network.client is what lets the app fetch the appcast and the DMG
	     itself. Sparkle's alternative is its Downloader.xpc service, which
	     exists precisely so an app *without* this entitlement can still
	     update — but Sparkle's own guidance is to pick one, and an app that
	     genuinely does make network requests should say so. Do NOT also set
	     SUEnableDownloaderService: with the entitlement present it is
	     redundant, and Sparkle warns about enabling both.

	     The mach-lookup exceptions let the sandboxed app reach Sparkle's
	     Installer.xpc, which does the install from outside the sandbox.
	     $(PRODUCT_BUNDLE_IDENTIFIER) expands at build time; the -spks/-spki
	     suffixes are Sparkle's, not ours, and must be spelled exactly. This
	     pair is required whenever SUEnableInstallerLauncherService is YES. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
</dict>
</plist>
