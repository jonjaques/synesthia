# Shared configuration for the direct-download release pipeline.
#
# Sourced (not executed) by build-direct.sh, make-appcast.sh, publish-release.sh
# and sparkle-keys.sh. Every value can be overridden from the environment, which
# is what makes it possible to rehearse a release against a scratch bucket:
#
#   R2_BUCKET=synesthia-releases-staging ./scripts/publish-release.sh
#
# The bucket name is also spelled in web/wrangler.jsonc, which is what binds it
# into the Pages Functions. Those two have to agree; nothing checks it for you.

R2_BUCKET="${R2_BUCKET:-synesthia-releases}"
SITE_URL="${SITE_URL:-https://synesthia.app}"
FEED_URL="${FEED_URL:-$SITE_URL/appcast.xml}"
# Trailing slash matters — generate_appcast concatenates this with the filename.
DOWNLOAD_BASE="${DOWNLOAD_BASE:-$SITE_URL/downloads}"

# The working directory that generate_appcast treats as the archive store. It
# holds the DMGs being published, the appcast, and Sparkle's own old_updates/.
RELEASES_DIR="${RELEASES_DIR:-build/releases}"

# Locate Sparkle's command line tools.
#
# They are not on PATH and there is no Homebrew formula worth depending on, but
# the Swift Package Manager artifact that the `Synesthia Direct` target already
# downloads contains them — so after any build of that target, they are present.
# $SPARKLE_BIN still wins, for a manually downloaded Sparkle release.
sparkle_bin() {
	if [[ -n "${SPARKLE_BIN:-}" && -x "$SPARKLE_BIN/generate_appcast" ]]; then
		echo "$SPARKLE_BIN"
		return 0
	fi

	local from_spm
	from_spm=$(/bin/ls -d "$HOME/Library/Developer/Xcode/DerivedData/Synesthia-"*/SourcePackages/artifacts/sparkle/Sparkle/bin 2>/dev/null | head -1)
	if [[ -n "$from_spm" && -x "$from_spm/generate_appcast" ]]; then
		echo "$from_spm"
		return 0
	fi

	local on_path
	on_path=$(command -v generate_appcast 2>/dev/null || true)
	if [[ -n "$on_path" ]]; then
		dirname "$on_path"
		return 0
	fi

	return 1
}

# Run wrangler against the Pages project in web/, where its config lives.
# `--remote` is explicit because wrangler will otherwise happily read and write
# a *local* simulated bucket, which looks like success and publishes nothing.
wrangler_r2() {
	(cd "$REPO_ROOT/web" && npx wrangler "$@" --remote)
}
