---
/**
 * Long-form text pages (privacy, support). Deliberately plainer than the
 * landing page: no canvas, no reveal-on-scroll, no audio — these are pages
 * people arrive at with a question, including App Review.
 */
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface Props {
	title: string;
	description: string;
	heading: string;
	standfirst: string;
	updated?: string;
	/** Page-specific JSON-LD, forwarded to the base layout. */
	schema?: Record<string, unknown>[];
}

const { title, description, heading, standfirst, updated, schema } = Astro.props;

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const pages = [
	['/support', 'Support'],
	['/privacy', 'Privacy'],
] as const;
---

<Base
	title={`${title} — ${SITE.name}`}
	pageName={title}
	description={description}
	ogType="article"
	schema={schema}
>
	<header class="border-b border-line">
		<div class="rail flex items-center justify-between gap-4 py-6">
			<a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
				<Mark size={24} class="h-6 w-6" />
				<span class="font-display font-semibold tracking-tight">Synesthia</span>
			</a>
			<nav aria-label="Pages" class="flex items-center gap-6 text-sm text-dim">
				{
					pages.map(([href, label]) => (
						<a
							href={href}
							aria-current={here === href ? 'page' : undefined}
							class:list={[
								'transition-colors hover:text-paper',
								here === href && 'text-paper',
							]}
						>
							{label}
						</a>
					))
				}
			</nav>
		</div>
	</header>

	<main id="main" class="rail max-w-3xl py-16 sm:py-24">
		<h1 class="display h1">{heading}</h1>
		<p class="mt-5 max-w-[46ch] text-lg text-dim">{standfirst}</p>
		{
			updated && (
				<p class="eyebrow mt-6">
					Last updated {updated}
				</p>
			)
		}

		<div class="legal mt-12">
			<slot />
		</div>
	</main>

	<Footer />
</Base>

<style is:global>
	/* Scoped to the prose block so the landing page is untouched. */
	.legal h2 {
		font-family: var(--font-display);
		font-weight: 600;
		letter-spacing: -0.02em;
		font-size: 1.5rem;
		margin-top: 3rem;
		margin-bottom: 0.75rem;
	}

	.legal h3 {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.125rem;
		margin-top: 2rem;
		margin-bottom: 0.5rem;
	}

	.legal h2:first-child,
	.legal h3:first-child {
		margin-top: 0;
	}

	.legal p,
	.legal li {
		color: var(--color-dim);
	}

	.legal p {
		margin-bottom: 1rem;
	}

	.legal ul {
		list-style: disc;
		padding-left: 1.35rem;
		margin-bottom: 1rem;
	}

	.legal li {
		margin-bottom: 0.5rem;
	}

	.legal li::marker {
		color: var(--color-mute);
	}

	.legal strong {
		color: var(--color-paper);
		font-weight: 600;
	}

	.legal a {
		color: var(--color-paper);
		text-decoration: underline;
		text-decoration-color: var(--color-line);
		text-underline-offset: 3px;
	}

	.legal a:hover {
		text-decoration-color: var(--color-mute);
	}

	.legal dl {
		margin-bottom: 1rem;
	}

	.legal dt {
		color: var(--color-paper);
		font-weight: 600;
		margin-top: 1rem;
	}

	.legal dd {
		color: var(--color-dim);
	}
</style>
