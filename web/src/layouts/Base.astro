---
import { Font } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import { SITE } from '../consts';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/**
	 * The page's short name, for the breadcrumb. Defaults to `title`, which is
	 * usually right for the landing page and never right for the others — a
	 * breadcrumb reading "Support — Synesthia" under "Synesthia" says the suffix
	 * twice.
	 */
	pageName?: string;
	/** `article` for the legal pages; the landing page is the site itself. */
	ogType?: 'website' | 'article';
	/**
	 * Page-specific JSON-LD, merged after this layout's own nodes. The product
	 * entity lives on the landing page and the FAQ entity on the support page —
	 * emitting either from here would claim, on every URL, that the page is a
	 * `SoftwareApplication`, which is the sort of thing Google quietly discounts
	 * the whole graph for.
	 */
	schema?: Record<string, unknown>[];
	/** Keep a page out of the index without removing it from the site. */
	noindex?: boolean;
}

const {
	title = SITE.title,
	description = SITE.description,
	pageName,
	ogType = 'website',
	schema: pageSchema = [],
	noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/img/og.png', Astro.site).href;
const isHome = Astro.url.pathname === '/';

// The card is the wordmark over the app's own spectrum artwork — not a
// screenshot. It used to be described as one, which is exactly the kind of alt
// text that reads fine right up until someone relies on it.
const ogImageAlt =
	'The Synesthia app icon and wordmark over layered rainbow spectrum ribbons on black, captioned “Music visualizer for macOS”.';

// The placeholder handle in consts.ts is not a real account, and a card that
// attributes itself to a handle that 404s is worse than one that doesn't.
const twitterHandle = SITE.social === '@synesthia_app' ? null : SITE.social;

// One WebSite node for the site, on the page that represents it; every other
// page describes itself and its position instead. Both are what Google reads to
// name the site and to draw a breadcrumb in place of a bare URL.
const website = {
	'@type': 'WebSite',
	'@id': `${Astro.site?.href}#website`,
	name: SITE.name,
	url: Astro.site?.href,
	description: SITE.description,
	publisher: { '@type': 'Person', name: SITE.author },
};

const baseSchema: Record<string, unknown>[] = isHome
	? [website]
	: [
			{
				'@type': 'WebPage',
				'@id': `${canonical}#webpage`,
				name: title,
				description,
				url: canonical,
				isPartOf: { '@id': `${Astro.site?.href}#website` },
				breadcrumb: {
					'@type': 'BreadcrumbList',
					itemListElement: [
						{ '@type': 'ListItem', position: 1, name: SITE.name, item: Astro.site?.href },
						{ '@type': 'ListItem', position: 2, name: pageName ?? title, item: canonical },
					],
				},
			},
		];

const graph = {
	'@context': 'https://schema.org',
	'@graph': [...baseSchema, ...pageSchema],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="robots"
			content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
		/>
		<meta name="author" content={SITE.author} />
		<meta name="theme-color" content="#0A0912" />
		<meta name="color-scheme" content="dark" />

		<!-- Icons. Every one of these is derived from the Icon Composer export by
		     `npm run assets` — there is no hand-drawn version of the mark. -->
		<link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
		<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
		<link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={SITE.locale} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		{
			twitterHandle && (
				<Fragment>
					<meta name="twitter:site" content={twitterHandle} />
					<meta name="twitter:creator" content={twitterHandle} />
				</Fragment>
			)
		}

		<!-- Apple -->
		<meta name="apple-mobile-web-app-title" content={SITE.name} />

		<Font cssVariable="--font-familjen" preload />
		<Font cssVariable="--font-plex" preload />
		<Font cssVariable="--font-plex-mono" />

		<script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />

		<Analytics />
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-paper focus:px-5 focus:py-2 focus:font-semibold focus:text-ink"
		>
			Skip to content
		</a>
		<slot />

		<!-- Loaded on every page, including the legal ones, which have no other
		     JavaScript: outbound and mailto clicks happen there too. Attaches
		     nothing unless <Analytics /> above actually loaded the tag. -->
		<script>
			import '../scripts/analytics';
		</script>
	</body>
</html>
