---
import { APP_STORE_URL } from '../consts';

interface Props {
	/** `compact` is the nav pill; `full` is the two-line store badge. */
	size?: 'compact' | 'full';
	class?: string;
}

const { size = 'full', class: className = '' } = Astro.props;
---

<a
	href={APP_STORE_URL}
	class:list={[
		'btn btn-primary group',
		size === 'compact' ? 'px-4 py-2 text-sm' : 'px-6 py-3.5',
		className,
	]}
	data-store-link
>
	<svg
		viewBox="0 0 22 24"
		class:list={['shrink-0 fill-current', size === 'compact' ? 'h-4 w-4' : 'h-6 w-6']}
		aria-hidden="true"
		focusable="false"
	>
		<path
			d="M16.365 1.43c0 1.14-.47 2.24-1.24 3.04-.83.87-2.19 1.54-3.3 1.45-.13-1.1.42-2.27 1.17-3.02.83-.87 2.29-1.5 3.37-1.47zM20.9 17.2c-.55 1.27-.81 1.84-1.52 2.96-.99 1.56-2.38 3.5-4.11 3.51-1.53.02-1.93-1-4.01-.99-2.08.01-2.51 1.01-4.05.99-1.72-.02-3.04-1.77-4.03-3.33C.4 15.98-.05 10.85 1.74 8.13c1.27-1.93 3.28-3.06 5.16-3.06 1.92 0 3.12 1.05 4.71 1.05 1.54 0 2.48-1.05 4.7-1.05 1.67 0 3.45.91 4.71 2.48-4.14 2.27-3.47 8.19.88 9.65z"
		></path>
	</svg>
	{
		size === 'compact' ? (
			<span>Mac App Store</span>
		) : (
			<span class="text-left leading-none">
				<span class="block font-mono text-[0.6rem] font-medium tracking-[0.18em] uppercase opacity-60">
					Download on the
				</span>
				<span class="mt-1 block font-display text-lg font-extrabold tracking-tight">
					Mac App Store
				</span>
			</span>
		)
	}
</a>
