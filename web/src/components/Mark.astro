---
/**
 * The app icon, straight from the Icon Composer export. `npm run assets`
 * regenerates the PNGs below from `assets/Icon Exports/`; nothing here is
 * redrawn by hand, so the site can never drift from the shipping icon.
 */
interface Props {
	class?: string;
	/** Rendered CSS size in px — sets the intrinsic size so the srcset picks right. */
	size?: number;
}

const { class: className = '', size = 32 } = Astro.props;
---

<img
	src="/img/icon-64.png"
	srcset="/img/icon-64.png 64w, /img/icon-128.png 128w, /img/icon-256.png 256w"
	sizes={`${size}px`}
	width={size}
	height={size}
	alt=""
	aria-hidden="true"
	decoding="async"
	class={className}
/>
