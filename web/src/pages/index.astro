---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import StoreButton from '../components/StoreButton.astro';
import { RELEASE, SITE } from '../consts';

const visualizers = [
	{
		viz: 'nebula',
		name: 'Nebula',
		line: 'A particle cloud in orbit. Every particle is bound to one frequency band and flares when its band hits.',
		options: ['Density', 'Glow', 'Swirl'],
	},
	{
		viz: 'tunnel',
		name: 'Spectrum Tunnel',
		line: 'Flight through a tube whose angular slices are the live spectrum. Loud frequencies push the walls out.',
		options: ['Twist', 'Glow'],
	},
	{
		viz: 'aurora',
		name: 'Aurora',
		line: 'Layered ribbons riding the waveform, each one glowing with its own slice of the spectrum.',
		options: ['Ribbons', 'Wave height'],
	},
];

const palettes = [
	{ name: 'Prism', colors: ['#2E9BFF', '#3FE39B', '#F2D544', '#FF7A18', '#FF2D2D'] },
	{ name: 'Ember', colors: ['#3B0A02', '#8C1A05', '#E0470C', '#FF9A2E', '#FFE3A3'] },
	{ name: 'Ocean', colors: ['#04283F', '#0A5D80', '#12A2B5', '#5BD9C6', '#CFF6EE'] },
	{ name: 'Violet', colors: ['#1B0E63', '#4326B8', '#7B4BFF', '#B98CFF', '#EDE0FF'] },
	{ name: 'Mono', colors: ['#141225', '#3A3752', '#6D6889', '#A9A5C0', '#EDE9FF'] },
];

const sources = [
	{
		name: 'Music app',
		does: 'Controls Music.app and taps the system audio it produces.',
		shows: 'Title, artist, album, artwork',
	},
	{
		name: 'System audio',
		does: 'Whatever the Mac is playing — Spotify, a browser tab, a game.',
		shows: 'Nothing to report',
	},
	{
		name: 'Audio input',
		does: 'A microphone, line-in, or any other input device.',
		shows: 'Device name',
	},
	{
		name: 'Audio file',
		does: 'Plays a file from disk inside the app, on loop.',
		shows: 'File name',
	},
];

const chain = [
	{
		stage: 'Capture',
		spec: 'ScreenCaptureKit · AVAudioEngine',
		accent: '#2E9BFF',
		line: 'System audio arrives through ScreenCaptureKit; a mic or a file arrives through an AVAudioEngine tap. Both end up as one mono stream.',
	},
	{
		stage: 'Analyse',
		spec: '2048-point FFT · vDSP',
		accent: '#3FE39B',
		line: 'A Hann-windowed 2048-point FFT runs on Accelerate, off the main thread, allocating nothing on the audio thread.',
	},
	{
		stage: 'Snapshot',
		spec: '64 bands · 30 Hz – 16 kHz',
		accent: '#F2D544',
		line: '64 log-spaced bands, a 256-sample waveform, bass, mid, treble and level scalars, plus a beat envelope from bass transients.',
	},
	{
		stage: 'Render',
		spec: '60 fps · Metal',
		accent: '#FF7A18',
		line: 'The render loop pulls the newest snapshot each frame and hands it straight to a Metal shader. Audio never publishes into the UI.',
	},
];

const shortcuts = [
	{ keys: ['Space'], does: 'Play or pause' },
	{ keys: ['⌘', '1'], does: 'Switch visualizer' },
	{ keys: ['⌘', '→'], does: 'Next track' },
	{ keys: ['⌘', 'O'], does: 'Open an audio file' },
	{ keys: ['⌃', '⌘', 'F'], does: 'Fullscreen' },
];

const native = [
	{
		title: 'Real fullscreen',
		body: 'The green button or ⌃⌘F. The controls fade out on their own and come back when you move the mouse.',
	},
	{
		title: 'Now playing',
		body: 'Title, artist and the track’s own artwork, pulled straight from Music while it plays.',
	},
	{
		title: 'Open to new visualizers',
		body: 'A visualizer is a class, a descriptor and a shader. Add one and its sliders appear in the options panel on their own.',
	},
];

const ticks = ['30 Hz', '100', '300', '1k', '3k', '10k', '16k'];

const readouts = [
	{ key: 'bass', label: 'Bass' },
	{ key: 'mid', label: 'Mid' },
	{ key: 'treble', label: 'Treble' },
	{ key: 'level', label: 'Level' },
];

const navLinks = [
	['Visualizers', '#visualizers'],
	['Sources', '#sources'],
	['How it works', '#pipeline'],
];
---

<Base>
	<!-- ================================================================ nav -->
	<header class="fixed inset-x-0 top-0 z-40">
		<div class="rail flex items-center justify-between gap-6 py-4">
			<a href="#main" class="flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
				<Mark class="h-7 w-7" />
				<span class="font-display text-lg font-bold tracking-tight">Synesthia</span>
			</a>

			<nav
				aria-label="Sections"
				class="panel hidden items-center gap-1 rounded-full px-2 py-1.5 md:flex"
			>
				{
					navLinks.map(([label, href]) => (
						<a
							href={href}
							class="rounded-full px-3.5 py-1.5 text-sm text-dim transition-colors hover:bg-white/5 hover:text-paper"
						>
							{label}
						</a>
					))
				}
			</nav>

			<StoreButton size="compact" class="hidden sm:inline-flex" />
		</div>
	</header>

	<main id="main">
		<!-- ============================================================ hero -->
		<section class="relative isolate overflow-hidden pt-28 pb-16 md:pt-36 md:pb-24">
			<!-- The comet from the app icon, drawn live from the same kind of
			     signal the app itself analyses. Pushed right on wide screens so
			     its head never sits under the headline. -->
			<canvas
				data-viz="comet"
				aria-hidden="true"
				class="pointer-events-none absolute inset-0 -z-10 h-full w-full opacity-50 md:left-[27%] md:w-auto md:opacity-100"></canvas>
			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(180deg,var(--color-void)_1%,transparent_44%,var(--color-void)_98%)] md:bg-[linear-gradient(96deg,var(--color-void)_14%,transparent_58%)]"
			>
			</div>

			<div class="rail grid items-center gap-14 md:grid-cols-12">
				<div class="md:col-span-6 lg:col-span-5">
					<p class="tag">{SITE.tagline}</p>

					<h1 class="display mt-5 text-[clamp(3.25rem,10vw,5.75rem)]">
						Music you<br /><span class="refract">can see.</span>
					</h1>

					<p class="mt-7 max-w-[34ch] text-lg text-dim">
						Synesthia turns whatever your Mac is playing into light. A 64-band FFT drives every
						frame, so bass, mids and treble each shape the picture differently.
					</p>

					<div class="mt-9 flex flex-wrap items-center gap-3">
						<StoreButton />
						<button type="button" class="btn btn-ghost" data-mic-toggle aria-pressed="false">
							<span class="inline-block h-2 w-2 shrink-0 rounded-full bg-current" aria-hidden="true"
							></span>
							<span data-mic-label>Use your mic</span>
						</button>
					</div>

					<p
						class="mt-4 text-sm text-mute data-[error=true]:text-spec-orange"
						data-mic-status
						role="status"
					>
						Nothing is recorded, and no audio leaves this page.
					</p>

					<p class="mt-8 font-mono text-xs tracking-wider text-mute uppercase">
						{RELEASE.requires} · {RELEASE.chip} · Version {RELEASE.version}
					</p>
				</div>
			</div>
		</section>

		<!-- ======================================================== analyser -->
		<section class="rail pb-24 md:pb-32" aria-label="Live spectrum analyser">
			<div class="panel overflow-hidden px-5 py-5 sm:px-7 sm:py-6" data-reveal>
				<div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
					<p class="tag">Analyser · 64 bands · 30 Hz – 16 kHz</p>
					<dl class="flex gap-5 sm:gap-8">
						{
							readouts.map((r) => (
								<div class="flex items-baseline gap-2">
									<dt class="tag">{r.label}</dt>
									<dd class="font-mono text-sm text-paper tabular-nums" data-readout={r.key}>
										00
									</dd>
								</div>
							))
						}
					</dl>
				</div>

				<canvas data-viz="spectrum" aria-hidden="true" class="mt-5 h-24 w-full sm:h-32"></canvas>

				<div
					class="mt-3 flex justify-between border-t border-violet/15 pt-2.5 font-mono text-[0.65rem] tracking-widest text-mute uppercase"
					aria-hidden="true"
				>
					{ticks.map((tick) => <span>{tick}</span>)}
				</div>
			</div>
		</section>

		<!-- ===================================================== visualizers -->
		<section id="visualizers" class="rail scroll-mt-24 pb-28 md:pb-40">
			<div class="max-w-2xl" data-reveal>
				<p class="tag">Three visualizers</p>
				<h2 class="display mt-4 text-[clamp(2.25rem,5.5vw,3.5rem)]">
					Three ways to look<br />at the same song.
				</h2>
				<p class="mt-6 text-lg text-dim">
					Each one reads the same 64 bands and draws something different with them. Switch between
					them with <kbd>⌘1</kbd> <kbd>⌘2</kbd> <kbd>⌘3</kbd> without stopping the music.
				</p>
			</div>

			<ul class="mt-14 grid gap-5 md:grid-cols-3">
				{
					visualizers.map((v) => (
						<li class="panel flex flex-col overflow-hidden" data-reveal>
							<canvas
								data-viz={v.viz}
								aria-hidden="true"
								class="aspect-[4/3] w-full bg-[radial-gradient(120%_100%_at_50%_45%,#150A45_0%,#07031A_72%)]"
							/>
							<div class="flex flex-1 flex-col p-6">
								<h3 class="font-display text-xl font-bold tracking-tight">{v.name}</h3>
								<p class="mt-2.5 flex-1 text-[0.95rem] text-dim">{v.line}</p>
								<div class="mt-5 flex flex-wrap gap-1.5">
									{v.options.map((option) => (
										<span class="rounded-full border border-violet/25 px-2.5 py-1 font-mono text-[0.65rem] tracking-widest text-mute uppercase">
											{option}
										</span>
									))}
								</div>
							</div>
						</li>
					))
				}
			</ul>

			<div
				class="panel mt-5 flex flex-col gap-8 p-6 sm:p-8 lg:flex-row lg:items-center lg:gap-12"
				data-reveal
			>
				<p class="max-w-xs text-[0.95rem] text-dim">
					All three share <span class="text-paper">Sensitivity</span>, <span class="text-paper"
						>Speed</span
					> and five palettes. Whatever you set, the app remembers for next time.
				</p>
				<ul class="grid flex-1 grid-cols-3 gap-x-6 gap-y-5 sm:grid-cols-5">
					{
						palettes.map((p) => (
							<li>
								<span class="flex overflow-hidden rounded-full" aria-hidden="true">
									{p.colors.map((c) => (
										<span class="h-2.5 flex-1" style={`background:${c}`} />
									))}
								</span>
								<span class="tag mt-2 block">{p.name}</span>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- ========================================================= sources -->
		<section id="sources" class="rail scroll-mt-24 pb-28 md:pb-40">
			<div class="max-w-2xl" data-reveal>
				<p class="tag">Four inputs</p>
				<h2 class="display mt-4 text-[clamp(2.25rem,5.5vw,3.5rem)]">
					It listens to anything<br />your Mac plays.
				</h2>
			</div>

			<div class="mt-12" data-reveal>
				<div
					class="hidden grid-cols-[minmax(0,1fr)_minmax(0,2fr)_minmax(0,1.2fr)] gap-6 border-b border-violet/20 pb-3 md:grid"
				>
					<span class="tag">Source</span>
					<span class="tag">What it does</span>
					<span class="tag">Now playing shows</span>
				</div>

				<ul>
					{
						sources.map((s) => (
							<li class="grid gap-2 border-b border-violet/15 py-6 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)_minmax(0,1.2fr)] md:gap-6 md:py-5">
								<h3 class="font-display text-lg font-bold tracking-tight">{s.name}</h3>
								<p class="text-[0.95rem] text-dim">{s.does}</p>
								<p class="font-mono text-xs tracking-wide text-mute">{s.shows}</p>
							</li>
						))
					}
				</ul>
			</div>

			<p class="mt-8 max-w-2xl text-sm text-mute" data-reveal>
				Capture attaches on launch for system audio, and latches onto Music if a track is already
				playing when you open the app. macOS asks once for Screen &amp; System Audio Recording so the
				app can hear other apps, and once for Automation so it can drive Music. The video half of the
				screen recording API is never read.
			</p>
		</section>

		<!-- ======================================================== pipeline -->
		<section id="pipeline" class="rail scroll-mt-24 pb-28 md:pb-40">
			<div class="max-w-2xl" data-reveal>
				<p class="tag">Signal chain</p>
				<h2 class="display mt-4 text-[clamp(2.25rem,5.5vw,3.5rem)]">
					Sound to light,<br />sixty times a second.
				</h2>
				<p class="mt-6 text-lg text-dim">
					Four stages, in this order, every frame. None of them block the main thread.
				</p>
			</div>

			<ol class="mt-14 grid gap-px overflow-hidden rounded-2xl bg-violet/20 md:grid-cols-4">
				{
					chain.map((step) => (
						<li class="bg-void p-6 md:p-7" data-reveal>
							<span
								class="block h-1 w-10 rounded-full"
								style={`background:${step.accent}`}
								aria-hidden="true"
							/>
							<h3 class="mt-5 font-display text-lg font-bold tracking-tight">{step.stage}</h3>
							<p class="mt-1 font-mono text-[0.65rem] tracking-widest text-mute uppercase">
								{step.spec}
							</p>
							<p class="mt-4 text-[0.9rem] text-dim">{step.line}</p>
						</li>
					))
				}
			</ol>
		</section>

		<!-- =========================================================== macOS -->
		<section class="rail pb-28 md:pb-40">
			<div class="grid gap-12 md:grid-cols-12 md:gap-8">
				<div class="md:col-span-6" data-reveal>
					<p class="tag">Native</p>
					<h2 class="display mt-4 text-[clamp(2.25rem,5.5vw,3.5rem)]">Built like<br />a Mac app.</h2>
					<ul class="mt-9 space-y-5">
						{
							native.map((item) => (
								<li class="border-l border-violet/30 pl-5">
									<h3 class="font-display font-bold tracking-tight">{item.title}</h3>
									<p class="mt-1 text-[0.95rem] text-dim">{item.body}</p>
								</li>
							))
						}
					</ul>
				</div>

				<div class="md:col-span-6 md:col-start-8" data-reveal>
					<div class="panel p-6 sm:p-8">
						<p class="tag">Keyboard</p>
						<dl class="mt-6 space-y-4">
							{
								shortcuts.map((s) => (
									<div class="flex items-center justify-between gap-6 border-b border-violet/15 pb-4 last:border-0 last:pb-0">
										<dd class="text-[0.95rem] text-dim">{s.does}</dd>
										<dt class="flex shrink-0 gap-1">
											{s.keys.map((k) => (
												<kbd>{k}</kbd>
											))}
										</dt>
									</div>
								))
							}
						</dl>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================================= cta -->
		<section class="rail pb-24">
			<div class="panel relative isolate overflow-hidden px-7 py-16 text-center sm:px-12 sm:py-24" data-reveal>
				<img
					src="/img/comet.png"
					alt=""
					width="1400"
					height="1400"
					loading="lazy"
					decoding="async"
					aria-hidden="true"
					class="pointer-events-none absolute -top-[42%] left-1/2 -z-10 w-[170%] max-w-none -translate-x-1/2 opacity-50 mix-blend-screen sm:w-[105%]"
				/>

				<img
					src="/img/icon-256.png"
					alt="The Synesthia app icon"
					width="256"
					height="256"
					loading="lazy"
					decoding="async"
					class="mx-auto h-20 w-20 rounded-[1.35rem] shadow-[0_20px_60px_-15px_rgba(67,217,255,0.45)]"
				/>

				<h2 class="display mx-auto mt-8 max-w-[14ch] text-[clamp(2.5rem,7vw,4.5rem)]">
					Put it on and <span class="refract">turn it up.</span>
				</h2>

				<div class="mt-10 flex flex-wrap justify-center gap-3">
					<StoreButton />
					<button type="button" class="btn btn-ghost" data-mic-toggle aria-pressed="false">
						<span class="inline-block h-2 w-2 shrink-0 rounded-full bg-current" aria-hidden="true"
						></span>
						<span data-mic-label>Use your mic</span>
					</button>
				</div>

				<p class="mt-6 font-mono text-xs tracking-wider text-mute uppercase">
					{RELEASE.requires} · {RELEASE.size}
				</p>
			</div>
		</section>
	</main>

	<footer class="border-t border-violet/15">
		<div
			class="rail flex flex-col items-center justify-between gap-4 py-8 text-sm text-mute sm:flex-row"
		>
			<div class="flex items-center gap-2.5">
				<Mark class="h-5 w-5" />
				<span class="font-display font-bold tracking-tight text-dim">Synesthia</span>
			</div>
			<p>© 2026 {SITE.author}. {RELEASE.requires}.</p>
		</div>
	</footer>
</Base>

<script>
	import '../scripts/boot';
</script>
