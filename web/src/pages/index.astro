---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Footer from '../components/Footer.astro';
import ShotCarousel from '../components/ShotCarousel.astro';
import DownloadOptions from '../components/DownloadOptions.astro';
import Lightbox from '../components/Lightbox.astro';
import {
	APP_STORE_AVAILABLE,
	APP_STORE_URL,
	DIRECT_DOWNLOAD_AVAILABLE,
	DIRECT_DOWNLOAD_URL,
	RELEASE,
	SITE,
} from '../consts';

// Copy that only makes sense when a given channel is on the page. The closing
// heading named the App Store outright, and the Sources note drew a contrast
// between the two builds — both read as broken promises when only one is
// offered, so they follow the flags too.
const BOTH_CHANNELS = APP_STORE_AVAILABLE && DIRECT_DOWNLOAD_AVAILABLE;
const ctaHeading = APP_STORE_AVAILABLE ? 'Free on the Mac App Store.' : 'Free for your Mac.';

import auroraFull from '../assets/screenshots/aurora-fullscreen.png';
import barsFull from '../assets/screenshots/bars-fullscreen.png';
import nebulaFull from '../assets/screenshots/nebula-fullscreen.png';
import tunnelFull from '../assets/screenshots/tunnel-fullscreen.png';
import { fullSize } from '../lib/shots';

// This page is a business card, not a manual: one screen of pitch, one screen
// of proof, and the parts of the README a buyer actually needs. Every plate is
// a real capture taken by `make screenshots` off the shipping build — nothing
// here is a re-creation of the app.
//
// The order matches `VisualizerRegistry.all`, which is the order ⌘1, ⌘2, … select.
//
// This array is the page's only count of visualizers: the keyboard shortcut and
// the schema's feature list are derived from it below, and every heading around
// it is written to hold at any length. Adding a fifth plate should be adding a
// plate, not a hunt through the copy for the word "four".
const shots = [
	{
		name: 'Nebula',
		image: nebulaFull,
		alt: 'The Nebula visualizer: a cloud of blue, green and gold particles hanging on black inside a faint ring.',
		options: 'Density · Turbulence · Swirl',
		line: 'A hundred thousand particles, all simulated on the GPU. Bass holds the core, mids shear into a disc, hi-hats throw comets.',
	},
	{
		name: 'Spectrum Tunnel',
		image: tunnelFull,
		alt: 'The Spectrum Tunnel visualizer: the inside of a cave of glowing blue and gold rock and steam, lit from within, curving away out of sight.',
		options: 'Twist · Bend · Fog',
		line: 'A cave raymarched out of the spectrum itself. Loud bands push the rock in, and the bends really do hide what is behind them.',
	},
	{
		name: 'Aurora',
		image: auroraFull,
		alt: 'The Aurora visualizer: stacked ribbons of violet, blue, green, gold and red rippling across a starfield like northern lights.',
		options: 'Ribbons · Wave height · Stars',
		line: 'Eight ribbons, one per register — sub-bass on the horizon, air at the top. Kicks and hi-hats light the constellations.',
	},
	{
		name: 'Bars',
		image: barsFull,
		alt: 'The Bars visualizer: a mixing console drawn in perspective, with a wall of green-to-red LED meter columns, two lamp-lit VU needles either side of a waveform scope, and a row of lit faders receding below.',
		options: 'Columns · Peak hold · Meters',
		line: 'A mixing desk that plays the track. LED columns with hanging peak caps, VU needles with real ballistics, faders riding the mix.',
	},
];

const visualizers = await Promise.all(
	shots.map(async (v) => ({ ...v, full: await fullSize(v.image) })),
);

const palettes = [
	{ name: 'Prism', colors: ['#2E9BFF', '#3FE39B', '#F2D544', '#FF7A18', '#FF2D2D'] },
	{ name: 'Ember', colors: ['#3B0A02', '#8C1A05', '#E0470C', '#FF9A2E', '#FFE3A3'] },
	{ name: 'Ocean', colors: ['#04283F', '#0A5D80', '#12A2B5', '#5BD9C6', '#CFF6EE'] },
	{ name: 'Violet', colors: ['#1B0E63', '#4326B8', '#7B4BFF', '#B98CFF', '#EDE0FF'] },
	{ name: 'Mono', colors: ['#141225', '#3A3752', '#6D6889', '#A9A5C0', '#EDE9FF'] },
];

const sources = [
	{
		name: 'System audio',
		does: 'Music, Spotify, a browser tab, a game — whatever is coming out of the speakers. Names the track, too.',
	},
	{ name: 'Audio input', does: 'A microphone, an interface, line-in — any input device.' },
	{ name: 'Audio file', does: 'Plays a file from disk, on loop, inside the app.' },
];

const chain = [
	{
		stage: 'Hear it',
		spec: 'System audio · mic · file',
		line: 'Point it at an app, an input, or a file. The audio is read and dropped — nothing is recorded.',
	},
	{
		stage: 'Split it',
		spec: '64 bands · 30 Hz–16 kHz',
		line: 'A Fourier transform splits each slice into log-spaced bands, so the low end gets the detail it needs.',
	},
	{
		stage: 'Read it',
		spec: 'Kick, snare, hi-hat',
		line: 'Bass, mids and treble drive different parts of the picture. A bassline and a cymbal never move the same thing.',
	},
	{
		stage: 'Draw it',
		spec: 'Straight to the GPU',
		line: 'Metal shaders draw the newest reading, at whatever refresh rate your display runs — 120 Hz included.',
	},
];

const shortcuts = [
	{ keys: ['Space'], does: 'Play or pause' },
	{ keys: ['⌘', `1–${visualizers.length}`], does: 'Switch visualizer' },
	{ keys: ['⌘', '→'], does: 'Next track' },
	{ keys: ['⌘', 'O'], does: 'Open an audio file' },
	{ keys: ['⌃', '⌘', 'F'], does: 'Fullscreen' },
];

const native = [
	{
		title: 'Controls that get out of the way',
		body: 'The bottom bar fades after a few seconds of stillness. Real fullscreen leaves nothing but the visualizer.',
	},
	{
		title: 'Open to new visualizers',
		body: 'Every visualizer is a plug-in: declare your sliders, write a Metal shader, and the app builds the UI. MIT licensed, on GitHub.',
	},
];

const navLinks = [
	['Visualizers', '#visualizers'],
	['Sources', '#sources'],
	['How it works', '#pipeline'],
];

// The product entity, emitted only here — this page *is* the app's page, and a
// `SoftwareApplication` repeated on the privacy policy is a claim about the
// privacy policy.
//
// `screenshot` is deliberately absent. It used to be og.png, which is a title
// card with a wordmark on it and not a screenshot of anything. Pointing it at
// the real captures instead is a trap: touching an imported `ImageMetadata`
// anywhere outside a `<Picture>` — even to read `.width` — makes Astro emit the
// untouched original alongside its transforms, which here is 9.6 MB of 3420 px
// PNG added to every deploy. Google's software rich result does not read
// `screenshot`, so the honest omission costs nothing.
const abs = (path: string) => new URL(path, Astro.site).href;

const softwareApplication = {
	'@type': 'SoftwareApplication',
	'@id': `${Astro.site?.href}#app`,
	name: SITE.name,
	applicationCategory: 'MultimediaApplication',
	applicationSubCategory: 'Music visualizer',
	operatingSystem: RELEASE.requires,
	softwareVersion: RELEASE.version,
	fileSize: RELEASE.size,
	description: SITE.description,
	url: Astro.site?.href,
	image: abs('/img/og.png'),
	author: { '@type': 'Person', name: SITE.author },
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
		availability: 'https://schema.org/InStock',
	},
	license: 'https://opensource.org/licenses/MIT',
	// Only advertise a download that exists — see the availability flags.
	...(DIRECT_DOWNLOAD_AVAILABLE ? { downloadUrl: abs(DIRECT_DOWNLOAD_URL) } : {}),
	...(APP_STORE_AVAILABLE ? { installUrl: APP_STORE_URL } : {}),
	featureList: [
		'64-band log-spaced FFT spectrum analysis from 30 Hz to 16 kHz',
		`${visualizers.length} GPU visualizers: ${visualizers.map((v) => v.name).join(', ')}`,
		'Captures system audio, microphone, line-in, or a local file',
		'Now-playing track info for Music and Spotify, with no permission required',
	],
};
---

<Base schema={[softwareApplication]}>
	<!-- ================================================================ nav -->
	<header class="sticky top-0 z-40 border-b border-line bg-ink/70 backdrop-blur-xl">
		<div class="rail flex h-14 items-center justify-between gap-6">
			<a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
				<Mark size={26} class="h-[26px] w-[26px]" />
				<span class="font-display text-[0.95rem] font-semibold tracking-tight">Synesthia</span>
			</a>

			<nav aria-label="Sections" class="hidden items-center gap-7 md:flex">
				{
					navLinks.map(([label, href]) => (
						<a href={href} class="text-sm text-dim transition-colors hover:text-paper">
							{label}
						</a>
					))
				}
			</nav>

			<DownloadOptions size="compact" placement="header" class="hidden sm:inline-flex" />
		</div>
	</header>

	<main id="main">
		<!-- ============================================================ hero -->
		<!-- The pitch and the proof on one screen: the carousel cycles every
		     visualizer in the same window, which is why the section below can be a
		     grid of small plates instead of a stack of full-width ones. -->
		<section class="rail pt-14 pb-24 sm:pt-20 md:pt-24 md:pb-32">
			<div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-14">
				<div>
					<p class="eyebrow">{SITE.tagline}</p>

					<h1 class="display h1 mt-5">Music you can see.</h1>

					<p class="mt-6 max-w-[42ch] text-lg text-dim">
						Synesthia turns whatever your Mac is playing into light. It splits the sound into 64 bands,
						sixty times a second, so a kick, a snare and a cymbal each move something different.
					</p>

					<div class="mt-8 flex flex-wrap items-center gap-3">
						<DownloadOptions placement="hero" />
						<a href="#visualizers" class="btn btn-secondary text-[0.9375rem]">See it running</a>
					</div>

					<p class="spec mt-6">
						Free · {RELEASE.requires} · {RELEASE.chip} · {RELEASE.size}
					</p>
				</div>

				<div>
					<ShotCarousel />
				</div>
			</div>
		</section>

		<!-- ===================================================== visualizers -->
		<section id="visualizers" class="rail scroll-mt-20 pb-24 md:pb-32">
			<div class="max-w-[42rem]" data-reveal>
				<p class="eyebrow">Visualizers</p>
				<h2 class="display h2 mt-4">Same song, different eyes.</h2>
				<p class="mt-5 text-dim">
					Every visualizer reads the same 64 bands and arrives somewhere different. Switch with
					<kbd>⌘</kbd> and a number, without stopping the music — each one remembers its own{' '}
					<span class="text-paper">Sensitivity</span>, <span class="text-paper">Speed</span>, palette
					and sliders, so switching back restores the look you set.
				</p>
			</div>

			<div class="mt-12 grid gap-8 sm:grid-cols-2 sm:gap-6">
				{
					visualizers.map((v, i) => (
						<figure data-reveal>
								<a
									class="plate shot-zoom"
									href={v.full}
									data-lightbox
									data-label={`${v.name}, fullscreen`}
									aria-label={`View the ${v.name} screenshot full size`}
								>
									<Picture
										src={v.image}
										formats={['avif']}
										fallbackFormat="webp"
										widths={[480, 720, 1000, 1400]}
										sizes="(min-width: 640px) 47vw, 100vw"
										alt={v.alt}
										loading={i === 0 ? 'eager' : 'lazy'}
									/>
									<span class="zoom-badge" aria-hidden="true">
										<svg viewBox="0 0 16 16" focusable="false">
											<path
												d="M6 2.75H2.75V6M10 13.25h3.25V10"
												stroke="currentColor"
												stroke-width="1.5"
												stroke-linecap="round"
												stroke-linejoin="round"
												fill="none"
											/>
										</svg>
									</span>
								</a>
							<figcaption class="mt-4">
								<h3 class="h3">{v.name}</h3>
								<p class="spec mt-1.5">{v.options}</p>
								<p class="mt-3 text-[0.95rem] text-dim">{v.line}</p>
							</figcaption>
						</figure>
					))
				}
			</div>

			<ul class="mt-12 grid grid-cols-3 gap-x-6 gap-y-4 sm:grid-cols-5" data-reveal>
				{
					palettes.map((p) => (
						<li>
							<span class="flex overflow-hidden rounded-sm" aria-hidden="true">
								{p.colors.map((c) => (
									<span class="h-2 flex-1" style={`background:${c}`} />
								))}
							</span>
							<span class="eyebrow mt-2 block">{p.name}</span>
						</li>
					))
				}
			</ul>
		</section>

		<!-- ========================================================= sources -->
		<section id="sources" class="rail scroll-mt-20 pb-24 md:pb-32">
			<div class="grid gap-10 md:grid-cols-12 md:gap-12">
				<div class="md:col-span-5" data-reveal>
					<p class="eyebrow">Sources</p>
					<h2 class="display h2 mt-4">It listens to anything your Mac plays.</h2>
					<p class="mt-5 text-sm text-mute">
						macOS asks once for Screen &amp; System Audio Recording — it is the only way it lets one app
						hear another. Synesthia keeps the sound and throws the picture away. Naming the track needs
						no permission at all: Music and Spotify already announce it, and Synesthia listens.{' '}
						{
							BOTH_CHANNELS &&
								'Play, pause and skip buttons ship in the build downloaded from this site; both builds show what is playing.'
						}
					</p>
				</div>

				<ul class="md:col-span-6 md:col-start-7" data-reveal>
					{
						sources.map((s) => (
							<li class="grid gap-1 border-b border-line-soft py-4 first:pt-0 last:border-0 last:pb-0 sm:grid-cols-[minmax(0,9rem)_minmax(0,1fr)] sm:items-baseline sm:gap-6">
								<h3 class="h3">{s.name}</h3>
								<p class="text-[0.95rem] text-dim">{s.does}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- ======================================================== pipeline -->
		<section id="pipeline" class="rail scroll-mt-20 pb-24 md:pb-32">
			<div class="max-w-[42rem]" data-reveal>
				<p class="eyebrow">How it works</p>
				<h2 class="display h2 mt-4">Sound to light, sixty times a second.</h2>
			</div>

			<ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6" data-reveal>
				{
					chain.map((step) => (
						<li class="border-t border-line pt-4">
							<h3 class="h3">{step.stage}</h3>
							<p class="spec mt-1.5">{step.spec}</p>
							<p class="mt-3 text-[0.95rem] text-dim">{step.line}</p>
						</li>
					))
				}
			</ol>
		</section>

		<!-- =========================================================== macOS -->
		<section id="native" class="rail scroll-mt-20 pb-24 md:pb-32">
			<div class="grid gap-12 md:grid-cols-12 md:gap-12">
				<div class="md:col-span-6" data-reveal>
					<p class="eyebrow">Native</p>
					<h2 class="display h2 mt-4">Built like a Mac app.</h2>
					<ul class="mt-8 space-y-6">
						{
							native.map((item) => (
								<li>
									<h3 class="h3">{item.title}</h3>
									<p class="mt-1.5 text-[0.95rem] text-dim">{item.body}</p>
								</li>
							))
						}
					</ul>
				</div>

				<div class="md:col-span-5 md:col-start-8" data-reveal>
					<div class="surface p-6">
						<p class="eyebrow">Keyboard</p>
						<!-- `dt` must precede its `dd` inside a `dl > div` — the reading order
						     is the term then its description, and a screen reader announces
						     them that way regardless of what CSS does. `flex-row-reverse`
						     keeps the keys on the right where they read better, without
						     putting the description first in the DOM. -->
						<dl class="mt-5">
							{
								shortcuts.map((s) => (
									<div class="flex flex-row-reverse items-center justify-between gap-6 border-b border-line-soft py-3 first:pt-0 last:border-0 last:pb-0">
										<dt class="flex shrink-0 gap-1">
											{s.keys.map((k) => (
												<kbd>{k}</kbd>
											))}
										</dt>
										<dd class="text-[0.95rem] text-dim">{s.does}</dd>
									</div>
								))
							}
						</dl>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================================= cta -->
		<section id="download" class="rail scroll-mt-20 pb-24 md:pb-32">
			<div class="surface flex flex-col items-center px-6 py-16 text-center sm:py-20" data-reveal>
				<img
					src="/img/icon-256.png"
					srcset="/img/icon-128.png 128w, /img/icon-256.png 256w"
					sizes="72px"
					alt=""
					aria-hidden="true"
					width="72"
					height="72"
					loading="lazy"
					decoding="async"
					class="h-[72px] w-[72px]"
				/>

				<h2 class="display h2 mt-7 max-w-[18ch]">{ctaHeading}</h2>

				<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
					<DownloadOptions placement="cta" />
				</div>

				<p class="spec mt-6">
					Version {RELEASE.version} · {RELEASE.requires} · {RELEASE.size}
				</p>

				<!-- Only worth saying when there is a choice to explain. -->
				{
					BOTH_CHANNELS && (
						<p class="mt-4 text-sm text-mute">
							The direct download adds playback controls for Music and Spotify, and updates itself.
						</p>
					)
				}
			</div>
		</section>
	</main>

	<Footer />

	<Lightbox />
</Base>

<script>
	import '../scripts/boot';
</script>
