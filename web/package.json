{
  "name": "synesthesia-web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "npm run format:check && npm run astro check",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro",
    "assets": "node scripts/gen-assets.mjs",
    "typecheck": "tsc -p tsconfig.functions.json",
    "cf-types": "wrangler types",
    "pages-dev": "wrangler pages dev ./dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "wrangler": "^4.114.0"
  }
}
