# Cloudflare Pages custom headers. Copied verbatim into dist/ by Astro (it is a
# public/ file) and read by Pages at deploy time — it is not part of the site.
#
# Two jobs: lock down what the pages are allowed to do, and let the immutable
# half of the build actually be cached. Pages serves every static asset with
# `max-age=0, must-revalidate` by default, which means a conditional request per
# hashed font and image on every visit — correct, but wasted on filenames that
# can never change contents.
#
# Functions (/appcast.xml, /download, /downloads/*) set their own cache headers
# in code; nothing here is meant to reach them.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  # There is no camera, mic, location or payment on this site, and no reason for
  # an embedded anything to acquire one.
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  # `unsafe-inline` for scripts is unavoidable on a static host: the JSON-LD
  # block and the analytics bootstrap are both inline, and a nonce would have to
  # be minted per response. The value of the policy here is the host allowlist —
  # nothing may load code from anywhere except this origin and Google's tag
  # server. `style-src` needs it too, for the palette swatches' style attribute.
  #
  # What is deliberately NOT allowed: doubleclick.net and stats.g.doubleclick.net.
  # GA4 only reaches for those once Google Signals or Ads linking is switched on
  # in the property, and this site has no advertising to attribute. If you enable
  # Signals and demographics stay empty, this line is why.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://cloudflareinsights.com; manifest-src 'self'; upgrade-insecure-requests

# Content-hashed by the build: the bytes behind one of these URLs never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed — regenerated by `npm run assets` under the same names — so these
# get a day rather than a year.
/img/*
  Cache-Control: public, max-age=86400
/favicon-16.png
  Cache-Control: public, max-age=86400
/favicon-32.png
  Cache-Control: public, max-age=86400
/favicon-48.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
